# Brewfile — `brew bundle` installs everything the dotfiles assume.
# github.com/josecolella/dotfiles

# --- Shell & prompt ---
brew "zsh"
brew "starship"     # cross-shell prompt
brew "zplug"        # zsh plugin manager

# --- Multiplexer ---
brew "tmux"

# --- Version manager ---
brew "mise"         # node/ruby/etc. pinned in .config/mise/config.toml

# --- CLI workflow ---
brew "gh"           # GitHub CLI
brew "fzf"          # fuzzy finder (zsh integration in .zshrc)
brew "stow"         # symlink farm manager — drives this repo
brew "neovim"

# --- Apps (casks) ---
cask "visual-studio-code"
cask "zed"
cask "iterm2"

# --- Fonts (shared across VS Code, Zed, and the terminal) ---
cask "font-monaspace"

# Add more as your toolbox grows: bat, ripgrep, fd, lazygit, jq, ...
